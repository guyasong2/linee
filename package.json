{
  "name": "linee",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/app.css --watch",
    "vendor": "mkdir -p static/js/vendor && cp node_modules/htmx.org/dist/htmx.min.js static/js/vendor/htmx.min.js",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/typography": "0.5.16",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "htmx.org": "2.0.11"
  }
}
